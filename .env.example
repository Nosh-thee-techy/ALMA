# Africa's Talking — SMS (sandbox OK)
AT_API_KEY=
AT_USERNAME=sandbox
AT_WHATSAPP_NUMBER=

# Messaging providers: auto | meta | africastalking | twilio | demo
# Primary stack for this project: Meta WhatsApp + Africa's Talking SMS.
WHATSAPP_PROVIDER=meta
SMS_PROVIDER=africastalking

# Twilio (optional only — not required for Meta/AT stack)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+14155238886
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WA_CONTENT_SID=
# TWILIO_WA_USE_TEMPLATE=false

# WhatsApp via Meta Cloud API (NGO SOS notify + desk alerts)
# META_WA_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_API_VERSION=v21.0

# Africa's Talking WhatsApp sender (optional alternative to Meta — no sandbox)
# AT_WHATSAPP_NUMBER=

ALMA_ENGINE_URL=http://127.0.0.1:8787
# Browser desk (Vite) — same engine URL for live Home/Dam/Rain/Alerts
VITE_ALMA_ENGINE_URL=http://127.0.0.1:8787
# Farmer After app — separate from the operator desk (open http://after.localhost:8080)
# VITE_FARMER_APP_ORIGIN=http://after.localhost:8080
# PUBLIC_BASE_URL=https://YOUR_SUBDOMAIN.ngrok-free.app

# USSD + SMS shortcode (Africa's Talking channel 51567 → dial *384*51567#)
# USSD_CHANNEL=51567
# AT_SMS_SHORTCODE=51567
# VITE_AT_SMS_SHORTCODE=51567
# VITE_USSD_CHANNEL=51567
# USSD_DIAL_CODE=*384*51567#
# VITE_USSD_DIAL_CODE=*384*51567#
# Dedicated SOS USSD (optional separate AT channel — else use menu option on main dial)
# SOS_USSD_DIAL_CODE=*384*51567#
# SOS_USSD_SERVICE_CODES=*384*51567#,*384*51567

# SOS routing / escalation (ALMA notifies responders — humans respond)
# ALMA_SOS_RESPONDER_PHONES=+2547xxxxxxx,+2547yyyyyyy
# ALMA_SOS_ACK_WINDOW_S=720
# ALMA_SOS_CHECKIN_WINDOW_S=900
# ALMA_SOS_ESCALATE_WINDOW_S=900
# ALMA_SOS_MAX_ESCALATIONS=3
# ALMA_SOS_DEDUPE_WINDOW_S=300
# ALMA_SOS_ONCALL_LEAD_PHONE=+2547zzzzzzz
# PLACEHOLDER — confirm a real Kenya Red Cross / county DMU line before live demo:
# ALMA_SOS_BACKUP_EMERGENCY_NUMBER=

# Featherless (cloud LLM when local Gemma is slow)
# FEATHERLESS_API_KEY=
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# ElevenLabs (Alma desk voice + Africa's Talking <Play>)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

