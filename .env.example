# Africa's Talking — SMS (sandbox OK)
AT_API_KEY=
AT_USERNAME=sandbox
AT_WHATSAPP_NUMBER=

# WhatsApp without AT — Meta Cloud API (recommended)
# WHATSAPP_PROVIDER=auto
# META_WA_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_API_VERSION=v21.0

ALMA_ENGINE_URL=http://127.0.0.1:8787
# PUBLIC_BASE_URL=https://YOUR_SUBDOMAIN.ngrok-free.app

# USSD (Africa's Talking channel → dial *384*<channel>#)
# USSD_CHANNEL=96428
# USSD_DIAL_CODE=*384*96428#

# Featherless (cloud LLM when local Gemma is slow)
# FEATHERLESS_API_KEY=
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct

# ElevenLabs (TTS for Voice / IVR)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Engine / Gemma
# OLLAMA_HOST=http://127.0.0.1:11434
# ALMA_FUNCTION_MODEL=gemma2:2b
# ALMA_ANALYST_MODEL=gemma2:9b
# ALMA_GEMMA_TIMEOUT_S=2
# ALMA_ANALYST_TIMEOUT_S=45
# DAM_TELEMETRY_URL=
# ALMA_OMO_LAT=7.05
# ALMA_OMO_LON=37.55
